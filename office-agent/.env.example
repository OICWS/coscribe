# Copy this file to .env and fill in the keys for the providers you use.
# Only the providers you actually configure a model for need a key set.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini Developer API key from https://aistudio.google.com/apikey (GOOGLE_API_KEY
# also works). This is a different, simpler auth path than aisuite's "google"
# provider, which targets Vertex AI (GCP project + service account) instead.
GEMINI_API_KEY=

# Model used by the Coordinator agent, as "provider:model" (aisuite convention).
# Replace with a model id valid for your account/provider, e.g.:
#   anthropic:claude-sonnet-4-5-20250929
#   openai:gpt-4o
#   gemini:gemini-2.5-flash
COSCRIBE_DEFAULT_MODEL=

# Directory the built-in file tools are allowed to read/write. Defaults to
# ./workspace under the current directory if unset.
COSCRIBE_WORKSPACE_ROOT=./workspace

# Optional: comma-separated absolute paths the built-in file/document/
# spreadsheet/presentation tools may also reach outside the workspace root --
# e.g. your Downloads folder, so a file an MCP tool just saved there doesn't
# need to be copied into the workspace first. _READABLE dirs can be read but
# not written to; _WRITABLE dirs can be both (no need to list one in both).
# Leave unset for none -- everything stays confined to the workspace root.
# COSCRIBE_EXTRA_READABLE_DIRS=/home/you/Downloads
# COSCRIBE_EXTRA_WRITABLE_DIRS=/home/you/Documents

# Optional: path to a JSON file giving the Coordinator agent tools from
# external MCP servers, in the same "mcpServers" shape as Claude Desktop's
# config. Every MCP tool is treated as medium risk and requires approval,
# same as write_file. Leave commented out for none. Example file content:
#   {"mcpServers": {"fetch": {"command": "uvx", "args": ["mcp-server-fetch"]}}}
# COSCRIBE_MCP_CONFIG_PATH=./mcp.json

# Optional: path to a JSON file of shell commands to run at PreToolUse (can
# deny a tool call), PostToolUse (logging/side effects), and SessionStart.
# Hooks run arbitrary shell commands with your own permissions -- only point
# this at configuration you trust. Leave commented out for none. Example
# file content:
#   {"PreToolUse": ["./hooks/audit.sh"], "PostToolUse": [], "SessionStart": []}
# COSCRIBE_HOOKS_CONFIG_PATH=./hooks.json

# Optional: fraction of the model's context window at which a thread is
# automatically compacted after a turn (see "Scheduled / unattended runs" in
# README.md -- this is what keeps a thread reused by a scheduler from
# growing forever). Defaults to 0.8 if unset. Set >= 1.0 to disable and rely
# on manual /compact only.
# COSCRIBE_AUTO_COMPACT_THRESHOLD=0.8

# Optional: corporate/network proxy. Setting this here works, not just as a
# real shell environment variable -- coscribe loads .env with override=True
# specifically so a value here reliably wins over a stale OS-level proxy
# already set (a real corporate-machine issue previously hit and fixed).
# LLM API calls pick this up automatically via each provider SDK's own
# standard support; web_search and the Browser panel's headless browser
# both forward it explicitly too (see runtime/proxy.py). NO_PROXY works the
# normal way (comma-separated hosts to bypass).
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
